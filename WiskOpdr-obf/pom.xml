		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3widget</artifactId>
			<version>1.0.3-SNAPSHOT</version>
		</dependency>
			<dependency>
			  	<groupId>nl.numworx.geogebra</groupId>
		  		<artifactId>geogebra4widget</artifactId>
		  		<version>1.0.3-SNAPSHOT</version>
			</dependency>
			<dependency>
