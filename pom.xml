<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>fi.wiskopdr</groupId>
	<artifactId>wiskopdr</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<build>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.7.0</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestFile>src/META-INF/MANIFEST.MF</manifestFile>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<properties>
		<project.build.sourceEncoding>ISO8859-1</project.build.sourceEncoding>
		<maven.test.skip>true</maven.test.skip>
	</properties>
	<dependencies>
		<dependency>
			<groupId>netscape.javascript</groupId>
			<artifactId>mayscript</artifactId>
			<version>1.0.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra3</artifactId>
			<version>3.2</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/output/jar/geogebra3.jar</systemPath>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra</artifactId>
			<version>4.0.29</version>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra_cas</artifactId>
			<version>4.0.29</version>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra_main</artifactId>
			<version>4.0.29</version>
		</dependency>
		<dependency>
			<groupId>fi.balansfruitapplet</groupId>
			<artifactId>balansfruitapplet</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>fi.graphtool</groupId>
			<artifactId>graphtool</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>com.github.lookfirst</groupId>
			<artifactId>sardine</artifactId>
			<version>5.1</version>
		</dependency>
	</dependencies>
	<name>WiskOpdr</name>
</project>
