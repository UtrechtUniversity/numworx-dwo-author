<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.previewhtml</groupId>
  <artifactId>PreviewHTML</artifactId>
  <version>0.0.2-SNAPSHOT</version>
  <name>HTML Previewer with Scorm support</name>
  <properties>
	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
	<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
	<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
  </properties>
  <dependencies>
  	<dependency>
  		<groupId>nl.uu.fi.dwo</groupId>
  		<artifactId>DWO-commons-lib</artifactId>
  		<version>2.4.10</version>
  	</dependency>
	<dependency>
		<groupId>nl.numworx.swingbrowser</groupId>
		<artifactId>swingbrowser-api</artifactId>
		<version>0.0.8</version>
		<scope>provided</scope>
	</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>DWOJClient</artifactId>
			<version>2.4.10</version>
			<scope>test</scope>
		</dependency>
  </dependencies>
  <build>
  	<finalName>previewhtml</finalName>
  	<plugins>
  	<plugin>
  		<artifactId>maven-compiler-plugin</artifactId>
  		<version>3.1</version>
  	</plugin>
	  <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>2.5.3</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
					<_snapshot>${osgi.qualifier}</_snapshot>
					<Main-Class>${project.groupId}.${project.artifactId}</Main-Class>
					<Export-Package>fi.previewhtml</Export-Package>
          </instructions>
        </configuration>
      </plugin>	
  	</plugins>
  </build>
  <profiles>
    <profile>
    	<id>jfx</id>
    	<dependencies>
    		<dependency>
				<groupId>nl.numworx.swingbrowser</groupId>
				<artifactId>swingbrowser-jfx</artifactId>
				<version>0.0.8-SNAPSHOT</version>
				<scope>test</scope>
			</dependency>
  		</dependencies>  	
    </profile>
  	<profile>
  		<id>jxb</id>
  		<dependencies>
			<dependency>
				<groupId>nl.numworx.swingbrowser</groupId>
				<artifactId>swingbrowser-jxb</artifactId>
				<version>0.0.8-SNAPSHOT</version>
				<scope>test</scope>
			</dependency>
  		</dependencies>
  	</profile>
  	<profile>
  		<id>signing</id>
  		<build>
  			<plugins>
  	<plugin>
		<groupId>org.apache.maven.plugins</groupId>
		<artifactId>maven-jarsigner-plugin</artifactId>
		<version>1.4</version>
		<executions>
			<execution>
				<phase>package</phase>
				<goals>
					<goal>sign</goal>
				</goals>
			</execution>
			<execution>
				<id>verify</id>
				<goals>
					<goal>verify</goal>
				</goals>
			</execution>
		</executions>
		<configuration>
			<keystore>${dwoKeyStore}</keystore>
			<alias>${dwoCertKeyAlias}</alias>
			<storepass>${dwoCertKeyStorePassword}</storepass>
			<keypass>${dwoCertKeyPassword}</keypass>
			<sigfile>UU</sigfile>
			<tsa>http://sha256timestamp.ws.symantec.com/sha256/timestamp</tsa>
		</configuration>
	</plugin>  
  			</plugins>
  		</build>
  	
  	</profile>
  </profiles>
  <packaging>bundle</packaging>
      <distributionManagement>
        <repository>
            <id>snapshots</id>
            <!--<name>libs-snapshot</name>-->
            <url>https://repos.dwo.nl/artifactory/libs-snapshot-local</url>    
        </repository>
    </distributionManagement>    
  <repositories>	
	<repository>
	  <id>com.teamdev</id>
	  <url>https://europe-maven.pkg.dev/jxbrowser/releases</url>
	</repository>
	  <repository>
	    <id>com.teamdev-old</id>
	    <url>http://maven.teamdev.com/repository/products</url>
	  </repository>
  </repositories>
  
</project>