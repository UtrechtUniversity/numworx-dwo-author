<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>nl.numworx.geodefiner</groupId>
  <artifactId>geodefiner</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>GeoDefiner</name>
  <dependencies>
  	<dependency>
  		<groupId>org.c-book</groupId>
  		<artifactId>cbookif</artifactId>
  		<version>1.0.2</version>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>org.c-book</groupId>
  		<artifactId>cbookeditor</artifactId>
  		<version>0.0.1-SNAPSHOT</version>
  		<scope>test</scope>
  	</dependency>
  	<dependency>
  		<groupId>fi.euclides</groupId>
  		<artifactId>euclides-util</artifactId>
  		<version>0.0.1-SNAPSHOT</version>
  	</dependency>
  	<dependency>
  		<groupId>fi.euclides</groupId>
  		<artifactId>euclides-core</artifactId>
  		<version>0.0.1-SNAPSHOT</version>
  	</dependency>
  	<dependency>
  		<groupId>fi.euclides</groupId>
  		<artifactId>euclides-expr</artifactId>
  		<version>0.0.1-SNAPSHOT</version>
  	</dependency>
  	<dependency>
  		<groupId>nl.numworx.geodefiner</groupId>
  		<artifactId>geodefiner-common</artifactId>
  		<version>0.0.1-SNAPSHOT</version>
  	</dependency>
  	<dependency>
  		<groupId>fi.wiskopdr</groupId>
  		<artifactId>wiskopdr</artifactId>
  		<version>0.0.0</version>
  		<scope>system</scope>
  		<systemPath>${wiskopdr.dir}/wiskopdr.jar</systemPath>
  	</dependency>
  </dependencies>
  <build>
  	<plugins>
  	  <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>2.5.3</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
          		<Export-Package>nl.numworx.geodefiner</Export-Package>
          	    <Import-Package>!com.google.*,!com.googlecode.*,*</Import-Package>
          	    <Private-Package>
          	    	fi.euclides.*, 
          	    	nl.numworx.geodefiner.*,
 					nl.tue.win.riaca.openmath.lang,
 					nl.uu.fi.dwo.interaction.*
          	    </Private-Package>
          	    <Main-class>nl.numworx.geodefiner.GeoDefiner</Main-class>
<!--  				<Embed-Dependency>*;scope=compile|runtime;type=!pom;inline=true</Embed-Dependency> -->
<!-- 				<Embed-Dependency>euclides-*;inline=true</Embed-Dependency> -->
<!-- 				<Embed-Dependency>geodefiner-common;inline=true</Embed-Dependency> -->
<!-- 				<Embed-Dependency>interaction;inline=true</Embed-Dependency> -->
<!-- 				<Embed-Dependency>om-lib;inline=true</Embed-Dependency> -->
<!-- 				<Embed-Transitive>false</Embed-Transitive> -->
          </instructions>
        </configuration>
      </plugin>	
  	</plugins>  
  </build>
  <packaging>bundle</packaging>
  <properties>
  	<wiskopdr.dir>/Users/wim/Documents/workspace-luna/WiskOpdr/output/jar</wiskopdr.dir>
  </properties>
</project>