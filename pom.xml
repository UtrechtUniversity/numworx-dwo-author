<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>fi.wiskopdr</groupId>
	<artifactId>wiskopdr</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<build>
		<finalName>${project.artifactId}</finalName>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>test</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.7.0</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>stap1</id>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<phase>${extras.process}</phase>
						<configuration>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<includeScope>compile</includeScope>
							<excludeArtifactIds>balansfruitapplet,graphtool,geodefiner,statistiek</excludeArtifactIds>
							<stripVersion>true</stripVersion>
							<stripClassifier>true</stripClassifier>
						</configuration>
					</execution>
					<execution>
						<id>stap2</id>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<phase>process-classes</phase>
						<configuration>
							<includeScope>compile</includeScope>
							<includeArtifactIds>balansfruitapplet,graphtool,geodefiner,statistiek</includeArtifactIds>
							<stripVersion>true</stripVersion>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>false</addClasspath>
							<classpathLayoutType>custom</classpathLayoutType>
							<customClasspathLayout>$${artifact.artifactId}.$${artifact.extension}</customClasspathLayout>
							<mainClass>fi.wiskopdr.WiskOpdr</mainClass>
						</manifest>
						<manifestEntries>
							<Class-Path>balansfruitapplet.jar doorziendwo.jar flowdiagrams.jar geogebra.jar geogebra3.jar geogebra3_cas.jar geogebra3_export.jar geogebra3_gui.jar geogebra3_main.jar geogebra3_properties.jar geogebra_cas.jar geogebra_main.jar geomalgebra.jar graphtool.jar mozarch.jar statistiek.jar stroomdiagrammen.jar tegels.jar verknippen.jar</Class-Path>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.github.wvengen</groupId>
				<artifactId>proguard-maven-plugin</artifactId>
				<version>2.0.14</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>proguard</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<proguardVersion>6.0</proguardVersion>
					<options>
						<option>-verbose</option>
						<option>-dontwarn</option>
						<option>-printconfiguration target/mapping.txt</option>
					</options>
					<obfuscate>true</obfuscate>
					<inputDirectory>${project.build.directory}</inputDirectory>
					<!-- <injar>${project.build.finalName}.jar</injar> -->
					<!-- uncomment to change the output file <outputDirectory>${project.build.directory}</outputDirectory> 
						<outjar>${project.build.finalName}.jar</outjar> -->
					<exclusions>
						<exclusion>
							<groupId>fi.graphtool</groupId>
							<artifactId>graphtool</artifactId>
						</exclusion>
						<exclusion>
							<groupId>fi.balansfruitapplet</groupId>
							<artifactId>balansfruitapplet</artifactId>
						</exclusion>
						<exclusion>
							<groupId>nl.numworx.geodefiner</groupId>
							<artifactId>geodefiner</artifactId>
						</exclusion>
						<exclusion>
							<groupId>fi.statistiek</groupId>
							<artifactId>statistiek</artifactId>
						</exclusion>
					</exclusions>
					<proguardInclude>toolfiles/config.pro</proguardInclude>
					<libs>
						<lib>${java.home}/lib/rt.jar</lib>
						<lib>${java.home}/lib/jsse.jar</lib>
						<lib>${java.home}/lib/ext/jfxrt.jar</lib>
					</libs>
					<addMavenDescriptor>false</addMavenDescriptor>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>net.sf.proguard</groupId>
						<artifactId>proguard-base</artifactId>
						<version>5.2</version>
						<scope>runtime</scope>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.8</version>
				<executions>
					<execution>
						<goals>
							<goal>run</goal>
						</goals>
						<phase>${extras.phase}</phase>
						<configuration>
							<target>
								<jar destfile="${project.build.directory}/${project.build.finalName}.jar"
									update="true" index="true">
									<indexjars>
										<fileset dir="${project.build.directory}" includes="*.jar"
											excludes="*proguard*" />
									</indexjars>
								</jar>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		<plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.0.0</version>
        <executions>
          <execution>
            <id>attach-artifacts</id>
            <phase>${extras.phase}</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/graphtool.jar</file>
                  <type>jar</type>
                  <classifier>graphtool</classifier>
                </artifact>
               <artifact>
                  <file>${project.build.directory}/balansfruitapplet.jar</file>
                  <type>jar</type>
                  <classifier>balansfruitapplet</classifier>
                </artifact>
                <artifact>
                  <file>${project.build.directory}/geodefiner.jar</file>
                  <type>jar</type>
                  <classifier>geodefiner</classifier>
                </artifact>
                <artifact>
                  <file>${project.build.directory}/statistiek.jar</file>
                  <type>jar</type>
                  <classifier>statistiek</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
                    <plugin>
                        <groupId>com.github.batkinson.plugins</groupId>
                        <artifactId>maven-pack200-plugin</artifactId>
                        <version>1.0.1</version>
                        <executions>
                            <execution>
                                <id>normalize-jars</id>
                                <phase>${extras.phase}</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>true</normalizeOnly>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pack-jars</id>
                                <phase>${extras.verify}</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>false</normalizeOnly>
                                </configuration>
                            </execution>
                        </executions>
                        <configuration>
                            <processMainArtifact>true</processMainArtifact>
                            <includeClassifiers>
                                <includeClassifier>graphtool</includeClassifier>
                                <includeClassifier>geodefiner</includeClassifier>
                                <includeClassifier>balansfruitapplet</includeClassifier>
                                <includeClassifier>statistiek</includeClassifier>
                            </includeClassifiers>
                        </configuration>                
                        <dependencies>
                            <dependency>
                                <groupId>com.github.batkinson.plugins</groupId>
                                <artifactId>maven-pack200-plugin</artifactId>
                                <version>1.0.1</version>
                                <type>maven-plugin</type>
                            </dependency>
                        </dependencies>                
                    </plugin>        
                    <!-- jar signing -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jarsigner-plugin</artifactId>
                        <version>1.4</version>
                        <executions>
                            <execution>
                                <phase>${extras.phase}</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>verify</id>
                                <phase>${extras.verify}</phase>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <processMainArtifact>true</processMainArtifact>
                            <keystore>${dwoKeyStore}</keystore>
                            <alias>${dwoCertKeyAlias}</alias>
                            <storepass>${dwoCertKeyStorePassword}</storepass>
                            <keypass>${dwoCertKeyPassword}</keypass>
                            <sigfile>UU</sigfile>
                            <tsa>http://sha256timestamp.ws.symantec.com/sha256/timestamp</tsa>
                        </configuration>            
                    </plugin>  
		</plugins>
	</build>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.test.skip>true</maven.test.skip>
		<geogebraVersion>4.0.29-r2017</geogebraVersion>
		<extras.phase>package</extras.phase>
		<extras.verify>verify</extras.verify>
		<extras.process>process-classes</extras.process>
	</properties>
