<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>fi.wiskopdr</groupId>
	<artifactId>wiskopdr</artifactId>
	<parent>
	  <groupId>fi.wiskopdr</groupId>
	  <artifactId>author-parent</artifactId>
	  <version>2.5.49-SNAPSHOT</version>
	</parent>

	<build>
		<finalName>${project.artifactId}</finalName>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>test</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.7.0</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>5.1.9</version>
    		  <executions>
		    <execution>
		      <id>bundle-manifest</id>
		      <phase>process-classes</phase>
		      <goals>    
		        <goal>manifest</goal>
		      </goals>   
		    </execution>
		  </executions>
				<configuration>
       	    		<niceManifest>true</niceManifest>
					<instructions>
						<_snapshot>${osgi.qualifier}</_snapshot>
<!-- uitzoeken welke optioneel zijn -->
						<Import-Package>
							fi.verknippen,
							fi.graphtool,
							fi.tegels,
							fi.statistiek,
							fi.geomalgebra,
							fi.mozarch,
							fi.doorziendwo,
							fi.stroomdiagrammen,
							!fi.beans.dwomaccess,
							!fi.wiskopdr.*,
							!geogebra.*,
							!org.mathpiper.*,
							!org.json.*,
							*;resolution:=optional
						</Import-Package>
						<Private-Package>
							fi.wiskopdr.*,
							org.json.*,
							uk.*
						</Private-Package>
						<DynamicImport-Package>geogebra,geogebra.cas.mpreduce,geogebra.plugin,org.mathpiper.mpreduce</DynamicImport-Package>
						<Export-Package>!uk.*,!org.json.*,org.cbook.cbookif;version="1.0.2",org.cbook.cbookif.rm;version="1.0.2",*</Export-Package>
						<Class-Path>balansfruitapplet.jar doorziendwo.jar geomalgebra.jar graphtool.jar mozarch.jar statistiek.jar stroomdiagrammen.jar tegels.jar verknippen.jar uploadwidgetrm.jar wiskopdrbeans.jar</Class-Path>
						<Main-Class>fi.wiskopdr.WiskOpdr</Main-Class>
						<Bundle-SymbolicName>fi.wiskopdr.WiskOpdr</Bundle-SymbolicName>
					</instructions>
				</configuration>
			</plugin>
			
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<archive>
      					<manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.test.skip>true</maven.test.skip>
		<geogebraVersion>4.0.29-r2017</geogebraVersion>
		<extras.phase>package</extras.phase>
		<extras.verify>verify</extras.verify>
		<extras.process>process-classes</extras.process>
		<extras.sign>none</extras.sign>
		<proguard.lib>${java.home}/lib/rt.jar</proguard.lib>
		<jxb>7.28.1</jxb>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
	<dependencies>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>dwojclient</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>dwo-commons-lib</artifactId>
			<scope>provided</scope>
		</dependency>
    	<dependency>
    		<groupId>fi.beans</groupId>
    		<artifactId>ideas</artifactId>
    		<version>1.2.8</version>
			<scope>provided</scope>
    	</dependency>
		<!-- #fi.verknippen #fi.mozarch #fi.tegels #fi.geomalgebra #fi.stroomdiagrammen 
			#fi.statistiek #fi.doorziendwo.DoorzienDWO: doorziendwo.jar #fi.dataplot.DataPlot: -->
		<dependency>
		  	<groupId>fi.wiskopdr</groupId>
	  		<artifactId>uploadwidgetrm</artifactId>
	  		<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>fi.balansfruitapplet</groupId>
			<artifactId>balansfruitapplet</artifactId>
			<version>${project.version}</version>
		</dependency>
  	<dependency>
  		<groupId>com.teamdev.jxbrowser</groupId>
  		<artifactId>jxbrowser-swing</artifactId>
  		<version>${jxb}</version>
  		<scope>runtime</scope>
  	</dependency>
  	<dependency>
  		<groupId>com.teamdev.jxbrowser</groupId>
  		<artifactId>jxbrowser-cross-platform</artifactId>
  		<version>${jxb}</version>
 	    <type>pom</type>
 	    <scope>runtime</scope>
  	</dependency>
		<dependency>
			<groupId>nl.numworx.swingbrowser</groupId>
			<artifactId>swingbrowser-jxb</artifactId>
			<scope>runtime</scope>
			<exclusions>
				<exclusion>
					<groupId>com.teamdev.jxbrowser</groupId>
					<artifactId>jxbrowser-cross-platform</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>nl.numworx.swingbrowser</groupId>
			<artifactId>swingbrowser-api</artifactId>
		</dependency>
		<dependency>
			<groupId>fi.beans</groupId>
			<artifactId>numworxlf</artifactId>
		</dependency>
		<dependency>
    		<groupId>javax.activation</groupId>
    		<artifactId>activation</artifactId>
    		<version>1.1.1</version>
    		<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>fi.dwo</groupId>
			<artifactId>fi.dwo.eawt</artifactId>
			<version>2.5.48</version> <!-- FIXME -->
			<scope>runtime</scope>
		</dependency>
			<dependency>
				<groupId>fi.wiskopdr.beans</groupId>
				<artifactId>wiskopdrbeans</artifactId>
				<version>${project.version}</version>
			</dependency>
	</dependencies>
	<name>WiskOpdr</name>
	<profiles>
		<profile>
			<id>devel</id>
			<properties>
				<proguard.skip>true</proguard.skip>
				<extras.phase>none</extras.phase>
				<extras.verify>none</extras.verify>
				<extras.process>none</extras.process>
			</properties>
		</profile>
		<profile>
			<id>notebook</id>
			<dependencies>
				<dependency>
					<groupId>nl.numworx.notebook</groupId>
					<version>0.0.1</version>
					<artifactId>notebook</artifactId>
				</dependency>
			</dependencies>
		</profile>
	<profile>
		<id>java17</id>
 		<properties>
 			<maven.compiler.source>11</maven.compiler.source>
 			<maven.compiler.target>11</maven.compiler.target>
 		</properties>
		<dependencies>
	    	<dependency>
	    		<groupId>fi.dwo</groupId>
	    		<artifactId>fi.dwo.eawt</artifactId>
	    		<version>0.0.2</version>
	    		<scope>runtime</scope>
	    	</dependency>
			<dependency>
	    		<groupId>javax.xml.bind</groupId>
	    		<artifactId>jaxb-api-osgi</artifactId>
	    		<version>2.2.7</version>
	    		<scope>runtime</scope>
			</dependency>
		</dependencies>
	</profile>
	<profile>
		<id>manifest</id>
		<properties>
			<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
			<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>		
		</properties>
		<build>
		  <plugins>
		     <plugin>   
		  <groupId>org.apache.felix</groupId>
		  <artifactId>maven-bundle-plugin</artifactId>
		  <version>4.2.1</version>
		    <dependencies>
		        <dependency>
		            <groupId>biz.aQute.bnd</groupId>
		            <artifactId>biz.aQute.bndlib</artifactId>
		            <version>4.2.0</version>
		        </dependency>
		    </dependencies>
    		  <executions>
		    <execution>
		      <id>bundle-manifest</id>
		      <phase>process-classes</phase>
		      <goals>    
		        <goal>manifest</goal>
		      </goals>   
		    </execution>
		  </executions>
       	  <configuration>
       	    <niceManifest>true</niceManifest>
          	<instructions>
   				<_snapshot>${osgi.qualifier}</_snapshot>
				<Bundle-SymbolicName>fi.wiskopdr.WiskOpdr</Bundle-SymbolicName>
				<Import-Package>fi.beans.mainframe,fi.beans.scorm,fi.beans.loader,fi.beans.ideas,javax.activation;resolution:=optional,javax.*,nl.numworx.swingbrowser.*,fi.beans.numworxlf,*;resolution:=optional</Import-Package>
				<Export-Package>!uk.*,org.cbook.cbookif;version="1.0.2",*</Export-Package>
          	</instructions>
          </configuration>
		</plugin>   
		  
		  </plugins>
		
		</build>
	
	
	</profile>
	<profile>
		<id>running11</id>
		<activation>
			<jdk>[9,)</jdk>
		</activation>
		<properties>
			<proguard.lib>${java.home}/jmods</proguard.lib>
		</properties>
	</profile>
	<profile>
		<id>repl</id>
		<dependencies>
			<dependency>
			  	<groupId>nl.numworx.repl</groupId>
		  		<artifactId>repl</artifactId>
		  		<version>${project.version}</version>
			</dependency>
		</dependencies>
	</profile>
	<profile>
		<id>aimodel</id>
		<dependencies>
			<dependency>
			  	<groupId>nl.numworx.aimodel</groupId>
		  		<artifactId>aimodel</artifactId>
		  		<version>0.0.3-SNAPSHOT</version>
			</dependency>
		</dependencies>
	</profile>
		<profile>
		<id>sqlite</id>
		<dependencies>
			<dependency>
			  	<groupId>nl.numworx.sqlite</groupId>
		  		<artifactId>sqlite</artifactId>
		  		<version>0.0.4-SNAPSHOT</version>
			</dependency>
		</dependencies>
	</profile>
	<profile>
		<id>stream</id>
		<dependencies>
			<dependency>
				<groupId>nl.numworx.stream</groupId>
				<artifactId>stream</artifactId>
				<version>1.0.0-SNAPSHOT</version>
				<optional>true</optional>
			</dependency>
		</dependencies>
		
	</profile>
	<profile>
		<id>fsm</id>
		<dependencies>
			<dependency>
				<groupId>nl.numworx.fsm</groupId>
				<artifactId>fsm</artifactId>
				<version>2.5.49-SNAPSHOT</version>
				<optional>true</optional>
			</dependency>
		</dependencies>
		
	</profile>

	<profile>
		<id>upload</id>
		<dependencies>
			<dependency>
			  	<groupId>fi.wiskopdr</groupId>
		  		<artifactId>uploadwidget</artifactId>
		  		<version>2.5.34</version>
			</dependency>
		</dependencies>
	</profile>
	<profile>
		<id>ggb4</id>
		<dependencies>
		</dependencies>
	</profile>
	
	</profiles>
  <repositories>	
	<repository>
	  <id>com.teamdev</id>
	  <url>https://europe-maven.pkg.dev/jxbrowser/releases</url>
	</repository>
  </repositories>
</project>
