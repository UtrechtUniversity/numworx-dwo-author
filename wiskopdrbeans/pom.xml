<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fi.wiskopdr</groupId>
    <artifactId>WiskOpdrParent</artifactId>
    <version>1.0.3-SNAPSHOT</version>
    <relativePath>../WiskOpdrParent</relativePath>
  </parent>
  <groupId>fi.wiskopdr.beans</groupId>
  <artifactId>wiskopdrbeans</artifactId>
  <packaging>bundle</packaging>
  <dependencies>
    <dependency>
     <artifactId>cbookif</artifactId>
     <groupId>org.c-book</groupId>
     <version>1.0.2</version>
    </dependency>
    <dependency>
       <groupId>nl.uu.fi.dwo</groupId>
       <artifactId>DWO-commons-lib</artifactId>
       <scope>provided</scope>
    </dependency>
  </dependencies>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
  <build>
	  <finalName>wiskopdrbeans</finalName>
	  <plugins>
		  <plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>5.1.9</version>
				<extensions>true</extensions>
				<configuration>
       	    		<niceManifest>true</niceManifest>
					<instructions>
						<_snapshot>${osgi.qualifier}</_snapshot>
					</instructions>
				</configuration>
		  </plugin>
	  </plugins>
  </build>
  <description>WiskOpdrApplet interface to implement by Widgets to connect to WiskOpdr</description>
  <name>WiskOpdr Beans</name>
</project>
