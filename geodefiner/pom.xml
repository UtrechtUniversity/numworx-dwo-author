<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.numworx.geodefiner</groupId>
	<artifactId>geodefiner</artifactId>
	<version>0.0.6-SNAPSHOT</version>
	<name>GeoDefiner</name>
	<dependencies>
		<dependency>
			<groupId>org.c-book</groupId>
			<artifactId>cbookif</artifactId>
			<version>1.0.2</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.c-book</groupId>
			<artifactId>cbookeditor</artifactId>
			<version>0.0.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>fi.euclides</groupId>
			<artifactId>euclides-util</artifactId>
			<version>0.0.8-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>fi.euclides</groupId>
			<artifactId>euclides-core</artifactId>
			<version>0.0.8-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>fi.euclides</groupId>
			<artifactId>euclides-expr</artifactId>
			<version>0.0.8-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geodefiner</groupId>
			<artifactId>geodefiner-common</artifactId>
			<version>0.0.7-SNAPSHOT</version>
		</dependency>
			<dependency>
				<groupId>fi.wiskopdr.beans</groupId>
				<artifactId>wiskopdrbeans</artifactId>
				<version>1.0.3-SNAPSHOT</version>
				<scope>provided</scope>
				<optional>true</optional>
			</dependency>
<!-- FIXME, make a dependency to the real uncompressed thing -->
		<dependency>
			<groupId>fi.wiskopdr</groupId>
			<artifactId>wiskopdr</artifactId>
			<version>2.0.3-SNAPSHOT</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>nl.tue.win.riaca.openmath</groupId>
			<artifactId>om-lib</artifactId>
			<version>1.3.18a</version>
		</dependency>
		<dependency>
			<groupId>fi.euclides</groupId>
			<artifactId>euclides-resources</artifactId>
			<version>0.0.8-SNAPSHOT</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>javax.inject</groupId>
			<artifactId>javax.inject</artifactId>
			<version>1</version>
		</dependency>
		<dependency>
			<groupId>com.google.dagger</groupId>
			<artifactId>dagger</artifactId>
			<version>${daggerVersion}</version>
		</dependency>
		<dependency>
			<groupId>com.google.dagger</groupId>
			<artifactId>dagger-compiler</artifactId>
			<version>${daggerVersion}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>fi.beans</groupId>
			<artifactId>numworxlf</artifactId>
			<version>2.5.4</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.googlecode.json-simple</groupId>
			<artifactId>json-simple</artifactId>
			<version>1.1.1</version>
			<scope>test</scope>
		</dependency>
    <dependency>
       <groupId>nl.uu.fi.dwo</groupId>
       <artifactId>DWO-commons-lib</artifactId>
       <version>2.5.46</version>
       <scope>provided</scope>
    </dependency>
	</dependencies>
	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.1</version>
				<!-- enable annotation processing after java 21 -->
				<configuration>
					<proc>full</proc>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>3.5.0</version>
				<extensions>true</extensions>
				<configuration>
					<createDependencyReducedPom>true</createDependencyReducedPom>
					<niceManifest>true</niceManifest>
					<dependencyReducedPomLocation>${basedir}/small-pom.xml</dependencyReducedPomLocation>
					<instructions>
						<_snapshot>${osgi.qualifier}</_snapshot>
						<Export-Package>nl.numworx.geodefiner</Export-Package>
						<Import-Package>!dagger.internal.codegen,!dagger.releasablereferences,!com.google.*,!com.googlecode.*,!nl.uu.fi.dwo.interaction.client.*,fi.*;resolution:=optional,*</Import-Package>
<!-- 						<DynamicImport-Package>fi.wiskopdr.*</DynamicImport-Package> -->
						<Require-Bundle>fi.wiskopdr.WiskOpdr</Require-Bundle>
						<Private-Package>
							fi.euclides.*,
							nl.numworx.geodefiner.*,
							nl.tue.win.riaca.openmath.lang,
							nl.uu.fi.dwo.interaction.client,
							nl.uu.fi.dwo.interaction.client.json,
							com.google.gwt.json.client,
							dagger,
							dagger.internal,
							dagger.multibindings,
							javax.inject.*
						</Private-Package>
						<Main-class>nl.numworx.geodefiner.GeoDefiner</Main-class>
						<Bundle-SymbolicName>nl.numworx.geodefiner.GeoDefiner</Bundle-SymbolicName>
						<Trusted-Only>true</Trusted-Only>
						<Permissions>all-permissions</Permissions>
						<Codebase>*.uu.nl *.dwo.nl localhost dme.mathhouse.org</Codebase>
						<Caller-Allowable-Codebase>*.uu.nl *.dwo.nl localhost</Caller-Allowable-Codebase>
						<Application-Name>GeoDefiner</Application-Name>
						<Application-Library-Allowable-Codebase>*</Application-Library-Allowable-Codebase>
						<Embed-Transitive>true</Embed-Transitive>
 						<Embed-Dependency>*;scope=compile;type=!pom;inline=true</Embed-Dependency>
					</instructions>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jarsigner-plugin</artifactId>
				<version>1.4</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>sign</goal>
						</goals>
					</execution>
					<execution>
						<id>verify</id>
						<goals>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<keystore>${dwoKeyStore}</keystore>
					<alias>${dwoCertKeyAlias}</alias>
					<storepass>${dwoCertKeyStorePassword}</storepass>
					<keypass>${dwoCertKeyPassword}</keypass>
					<sigfile>UU</sigfile>
					<tsa>https://timestamp.geotrust.com/tsa</tsa>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<packaging>bundle</packaging>
	<properties>
		<jarsigner.skip>true</jarsigner.skip>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<daggerVersion>2.42</daggerVersion>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
	<profiles>
		<profile>
			<id>java11</id>
			<dependencies>
				<dependency>
				    <groupId>javax.annotation</groupId>
				    <artifactId>javax.annotation-api</artifactId>
				    <version>1.3.2</version>
				    <scope>provided</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
