<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fi.wiskopdr</groupId>
    <artifactId>wiskopdr-parent</artifactId>
    <version>2.5.48-SNAPSHOT</version>
    <relativePath>../WiskOpdrParent</relativePath>
  </parent>
  <groupId>nl.numworx.geogebra</groupId>
  <artifactId>geogebra3widget</artifactId>
 	<dependencies>
		<dependency>
			<groupId>fi.wiskopdr.beans</groupId>
			<artifactId>wiskopdrbeans</artifactId>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>
<!-- FIXME, make a dependency to the real uncompressed thing -->
		<dependency>
			<groupId>fi.wiskopdr</groupId>
			<artifactId>wiskopdr</artifactId>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>dwo-commons-lib</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>fi.beans</groupId>
			<artifactId>numworxlf</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3</artifactId>
			<version>2.5.46</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3_main</artifactId>
			<version>2.5.46</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3_gui</artifactId>
			<version>2.5.46</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3_cas</artifactId>
			<version>2.5.46</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3_properties</artifactId>
			<version>2.5.46</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.geogebra</groupId>
			<artifactId>geogebra3_export</artifactId>
			<version>2.5.46</version>
		</dependency>
	</dependencies>
	<build>
   		<finalName>${project.artifactId}</finalName>
   	 <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.0</version>
      </plugin>
        <plugin>   
		  <groupId>org.apache.felix</groupId>
		  <artifactId>maven-bundle-plugin</artifactId>
          <version>2.5.3</version>
		  <executions>
		    <execution>
		      <id>bundle-manifest</id>
		      <phase>process-classes</phase>
		      <goals>    
		        <goal>manifest</goal>
		      </goals>   
		    </execution>
		  </executions>
       	  <configuration>
       	    <niceManifest>true</niceManifest>
          	<instructions>
   				<_snapshot>${osgi.qualifier}</_snapshot>
          		<Bundle-SymbolicName>nl.numworx.geogebra3.Geogebra3Widget</Bundle-SymbolicName>
 				<Main-Class>nl.numworx.geogebra3.Geogebra3Widget</Main-Class>
				<Application-Name>Geogebra3Widget</Application-Name>
				<Bundle-Name>Geogebra3Widget</Bundle-Name>
 				<Private-Package>*</Private-Package>
 				<Export-Package>nl.numworx.geogebra3</Export-Package>
 				<Import-Package>fi.beans.mainframe,fi.beans.scorm,fi.beans.wiskopdrbeans,v3.geogebra;version="[2,4)",*</Import-Package>
 				<Class-Path>geogebra3.jar geogebra3_cas.jar geogebra3_export.jar geogebra3_gui.jar geogebra3_main.jar geogebra3_properties.jar</Class-Path>
         	</instructions>
          </configuration>
         </plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<archive>
						<manifestFile>target/classes/META-INF/MANIFEST.MF</manifestFile>
					</archive>
				</configuration>
			</plugin>
       </plugins>
	</build>
	<properties>
		<maven.compiler.target>1.8</maven.compiler.target>
		<maven.compiler.source>1.8</maven.compiler.source>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
</project>
