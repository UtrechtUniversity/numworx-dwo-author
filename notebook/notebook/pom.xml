<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
	  <groupId>fi.wiskopdr</groupId>
	  <artifactId>author-parent</artifactId>
	  <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>notebook</artifactId>
  <dependencies>
 		<dependency>
			<groupId>fi.wiskopdr</groupId>
			<artifactId>wiskopdr</artifactId>
			<version>2.0.3-SNAPSHOT</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
        	<groupId>nl.uu.fi.dwo</groupId>
    		<artifactId>dwo-commons-lib</artifactId>
        	<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.c-book</groupId>
			<artifactId>cbookif</artifactId>
			<version>1.0.2</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.c-book</groupId>
			<artifactId>cbookeditor</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>nl.numworx.swingbrowser</groupId>
			<artifactId>swingbrowser-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.numworx.swingbrowser</groupId>
			<artifactId>swingbrowser-jxb</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>fi.beans</groupId>
			<artifactId>numworxlf</artifactId>
		</dependency>
  </dependencies>
  <build>
  	<finalName>notebook</finalName>
	<plugins>
        <plugin>   
		  <groupId>org.apache.felix</groupId>
		  <artifactId>maven-bundle-plugin</artifactId>
          <version>2.5.3</version>
		  <executions>
		    <execution>
		      <id>bundle-manifest</id>
		      <phase>process-classes</phase>
		      <goals>    
		        <goal>manifest</goal>
		      </goals>   
		    </execution>
		  </executions>
       	  <configuration>
       	    <niceManifest>true</niceManifest>
          	<instructions>
   				<_snapshot>${osgi.qualifier}</_snapshot>
          		<Bundle-SymbolicName>nl.numworx.notebook.Notebook</Bundle-SymbolicName>
 				<Main-Class>nl.numworx.notebook.Notebook</Main-Class>
				<Bundle-Description />
 				<Export-Package>nl.numworx.notebook</Export-Package>
 				<Import-Package>fi.beans.mainframe,fi.beans.wiskopdrbeans,*</Import-Package>
          	</instructions>
          </configuration>
         </plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<archive>
						<manifestFile>target/classes/META-INF/MANIFEST.MF</manifestFile>
					</archive>
				</configuration>
			</plugin>
	</plugins>
  </build>
	<properties>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
 	<repositories>	
	<repository>
	  <id>com.teamdev</id>
	  <url>https://europe-maven.pkg.dev/jxbrowser/releases</url>
	</repository>
    <repository>
        <id>numworx-dwo-project</id>
        <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-project</url>
        <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
        <id>numworx-vendor-jxbrowser</id>
        <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-vendor-jxbrowser</url>
        <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
        <id>numworx-vendor-cbook</id>
        <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-vendor-cbook</url>
        <snapshots><enabled>true</enabled></snapshots>
    </repository>

	</repositories>
 	<version>2.5.47-SNAPSHOT</version>
</project>
