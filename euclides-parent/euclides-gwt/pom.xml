<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>euclides-gwt</artifactId>
	<name>Euclides Util for GWT</name>
	<parent>
		<artifactId>euclides-parent</artifactId>
		<relativePath>..</relativePath>
		<groupId>fi.euclides</groupId>
		<version>2.5.51-SNAPSHOT</version>
	</parent>
	<dependencies>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-user</artifactId>
			<version>2.10.0</version>
		</dependency>
		<dependency>
			<groupId>org.vectomatic</groupId>
			<artifactId>lib-gwt-svg</artifactId>
			<version>0.5.11</version>
		</dependency>
		<dependency>
			<groupId>fi.euclides</groupId>
			<artifactId>euclides-core</artifactId>
		</dependency>
		<dependency>
			<groupId>fi.euclides</groupId>
			<artifactId>euclides-core</artifactId>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>nl.tue.win.riaca.openmath</groupId>
			<artifactId>om-lib</artifactId>
			<version>1.3.18b</version>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>gwt.geom</groupId>
			<artifactId>gwt-geom</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
		</dependency>
		<dependency>
		    <groupId>com.vaadin.addon</groupId>
		    <artifactId>pointer-events</artifactId>
		    <version>1.0</version>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src/main/java</directory>
			</resource>
		</resources>

	</build>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>
	<repositories>
		<repository>
			<id>vaadin-addons</id>
			<url>https://maven.vaadin.com/vaadin-addons/</url>
		</repository>
	</repositories>
</project>
