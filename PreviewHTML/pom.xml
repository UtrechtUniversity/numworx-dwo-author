<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.previewhtml</groupId>
  <artifactId>previewhtml</artifactId>
  <name>HTML Previewer with Scorm support</name>
  <parent>
	  <groupId>fi.wiskopdr</groupId>
	  <artifactId>wiskopdr-parent</artifactId>
	  <version>2.5.50</version>
	  <relativePath>../WiskOpdrParent</relativePath>
  </parent>
  <properties>
	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
	<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
	<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
  </properties>
  <dependencies>
  	<dependency>
  		<groupId>nl.uu.fi.dwo</groupId>
  		<artifactId>dwo-commons-lib</artifactId>
  	</dependency>
	<dependency>
		<groupId>nl.numworx.swingbrowser</groupId>
		<artifactId>swingbrowser-api</artifactId>
		<scope>provided</scope>
	</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>dwojclient</artifactId>
			<scope>test</scope>
		</dependency>
  </dependencies>
  <build>
  	<finalName>previewhtml</finalName>
  	<plugins>
  	<plugin>
  		<artifactId>maven-compiler-plugin</artifactId>
  		<version>3.1</version>
  	</plugin>
	  <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>2.5.3</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
					<_snapshot>${osgi.qualifier}</_snapshot>
					<Main-Class>${project.groupId}.${project.artifactId}</Main-Class>
					<Export-Package>fi.previewhtml</Export-Package>
          </instructions>
        </configuration>
      </plugin>	
  	</plugins>
  </build>
  <profiles>
    <profile>
    	<id>jfx</id>
    	<dependencies>
    		<dependency>
				<groupId>nl.numworx.swingbrowser</groupId>
				<artifactId>swingbrowser-jfx</artifactId>
				<version>0.0.19</version>
				<scope>test</scope>
			</dependency>
  		</dependencies>  	
    </profile>
  	<profile>
  		<id>jxb</id>
  		<dependencies>
			<dependency>
				<groupId>nl.numworx.swingbrowser</groupId>
				<artifactId>swingbrowser-jxb</artifactId>
				<scope>test</scope>
			</dependency>
  		</dependencies>
  	</profile>
  </profiles>
  <packaging>bundle</packaging>
  <repositories>	
	<repository>
	  <id>com.teamdev</id>
	  <url>https://europe-maven.pkg.dev/jxbrowser/releases</url>
	</repository>
    <repository>        
        <id>numworx-vendor-jxbrowser</id>
        <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-vendor-jxbrowser</url>
        <snapshots><enabled>true</enabled></snapshots>
    </repository>       
  </repositories>
  
</project>
