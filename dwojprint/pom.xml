<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fi.wiskopdr</groupId>
    <artifactId>author-parent</artifactId>
    <version>2.5.50</version>
  </parent>
  <artifactId>dwojprint</artifactId>
  <groupId>nl.uu.fi.dwo</groupId>
  <packaging>bundle</packaging>
  <name>DWO Printer</name>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
  <dependencies>
  	<dependency>
  		<groupId>com.lowagie</groupId>
  		<artifactId>itext</artifactId>
  		<version>2.1.7</version>
  	</dependency>
    <dependency>
    	<groupId>fi.beans</groupId>
    	<artifactId>numworxlf</artifactId>
    	<scope>provided</scope>
    </dependency>

  </dependencies>
  <build>
	  <finalName>${project.artifactId}</finalName>
	  <plugins>	  
		  <plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>5.1.9</version>
				<extensions>true</extensions>
				<configuration>
       	    		<niceManifest>true</niceManifest>
					<instructions>
						<_snapshot>${osgi.qualifier}</_snapshot>
						<Bundle-SymbolicName>fi.dwo.dwojprint.DWOJPrint</Bundle-SymbolicName>
						<Main-class>fi.dwo.dwojprint.DWOJPrint</Main-class>
						<Private-Package>com.lowagie.text.**,org.bouncycastle.**</Private-Package>
						<Embed-Transitive>true</Embed-Transitive>
 						<Embed-Dependency>*;scope=compile;type=!pom;inline=true</Embed-Dependency>
 						<Import-Package>!junit.*,!com.lowagie.toolbox,javax.*;resolution:=optional;com.apple.mrj;resolution:=optional,*</Import-Package>
					</instructions>
				</configuration>
		  </plugin>
                  <plugin>
                        <groupId>com.github.batkinson.plugins</groupId>
                        <artifactId>maven-pack200-plugin</artifactId>
                        <version>1.0.1</version>
                        <executions>
                            <execution>
                                <id>pack-jars</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>false</normalizeOnly>
                                </configuration>
                            </execution>
                        </executions>
                        <configuration>
                            <processMainArtifact>true</processMainArtifact>
                        </configuration>                
                    </plugin>        
	  </plugins>
  </build>
</project>
